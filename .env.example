DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
# Direct (non-pooled) connection, used by Prisma Migrate. On Neon, same as
# DATABASE_URL but with "-pooler" removed from the host.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

JWT_SECRET=replace-with-a-long-random-secret

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-username
EMAIL_PASS=your-smtp-password
EMAIL_FROM=your-smtp-username

# WhatsApp Cloud API (Meta) - sends the registration welcome message and the
# "missed today's quiz" reminder from the business number +91 70206 61030.
# Get these from Meta for Developers > your app > WhatsApp > API Setup.
WHATSAPP_ACCESS_TOKEN=your-meta-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_API_VERSION=v21.0

# Authenticates the daily missed-quiz-reminder cron request (see vercel.json).
# Vercel automatically sends this as a Bearer token when it invokes the cron.
CRON_SECRET=replace-with-a-long-random-secret
